<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Top Score Surface -->
    <LinearLayout
        android:id="@+id/score_container"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_surface_round"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/score_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 : 0"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/menu_button"
                style="@style/TvPillButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/pause" />

            <Space
                android:layout_width="16dp"
                android:layout_height="48dp" />

            <Button
                android:id="@+id/settings_button"
                style="@style/TvPillButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centered Game Area -->
    <com.example.ping_pong_frontend.GameView
        android:id="@+id/game_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/bg_table"
        app:layout_constraintTop_toBottomOf="@id/score_container"
        app:layout_constraintBottom_toTopOf="@id/hints_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"/>

    <!-- Bottom Hints Bar -->
    <LinearLayout
        android:id="@+id/hints_container"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_margin="48dp"
        android:background="@drawable/bg_surface_round_light"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/bottom_hints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DPAD ↑/↓ move • OK = Pause • ▶ Settings"
            android:textColor="@color/textSecondary"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Pause Overlay -->
    <FrameLayout
        android:id="@+id/pause_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/game_view"
        app:layout_constraintBottom_toBottomOf="@id/game_view"
        app:layout_constraintStart_toStartOf="@id/game_view"
        app:layout_constraintEnd_toEndOf="@id/game_view">

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="240dp"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_round"
            android:padding="24dp"
            android:gravity="center"
            android:elevation="12dp"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/pause_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paused"
                android:textColor="@color/textPrimary"
                android:textSize="26sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/pause_resume"
                style="@style/TvPillButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/resume" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <Button
                android:id="@+id/pause_settings"
                style="@style/TvPillButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/settings" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
